# Hosted Postgres (Neon / Supabase). Use the POOLED connection string.
DATABASE_URL=

# Any OpenAI-compatible chat-completions endpoint with image input (Groq, Together.ai, OpenRouter).
MODEL_API_KEY=
MODEL_BASE_URL=https://api.groq.com/openai/v1
MODEL_ID=meta-llama/llama-4-scout-17b-16e-instruct

# Private S3-compatible bucket (Cloudflare R2 shown).
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

LOG_LEVEL=info
# Comma-separated origins. Leave unset only for local development.
CORS_ORIGINS=
# Submissions still "processing" after this long are marked Error (no durable queue).
STALE_AFTER_MINUTES=10
